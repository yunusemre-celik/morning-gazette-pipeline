# ==============================================================================
# The Morning Gazette Pipeline - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini API Settings
# ------------------------------------------------------------------------------
# Google Gemini API Key (obtained from Google AI Studio).
# If omitted or unavailable, the pipeline gracefully switches to FallbackSummarizer.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model identifier (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# Standard SMTP Dispatch Settings (Gmail API / OAuth2 is strictly avoided)
# ------------------------------------------------------------------------------
# Standard SMTP host (e.g., smtp.sendgrid.net, smtp.mailgun.org, smtp.postmarkapp.com)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Sender & Recipient Configuration
SENDER_EMAIL=editor@morninggazette.internal
# Comma-separated list of subscriber emails
RECIPIENT_EMAILS=reader1@example.com,reader2@example.com

# ------------------------------------------------------------------------------
# Network, Timeout & Resilience Settings
# ------------------------------------------------------------------------------
# External API request timeout in seconds (maximum 10.0s)
REQUEST_TIMEOUT=10.0

# Exponential backoff retry attempts for Gemini API rate limits (429/500)
MAX_RETRIES=3

# ------------------------------------------------------------------------------
# Logging & Output Configuration
# ------------------------------------------------------------------------------
# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Directory for dry-run generated preview files
DIST_DIR=dist
